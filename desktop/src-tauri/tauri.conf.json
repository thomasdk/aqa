{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AQA",
  "version": "1.0.0-beta.1",
  "identifier": "app.aqa.desktop",
  "build": {
    "frontendDist": "resources/loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: http://127.0.0.1:*; style-src 'self' 'unsafe-inline' http://127.0.0.1:*; script-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "resources": ["resources/backend"],
    "copyright": "Copyright (c) 2026 Thomas Krause",
    "shortDescription": "Augmented Qualitative Analysis",
    "longDescription": "Augmented Qualitative Analysis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "bundleVersion": "1.0.0",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  }
}
